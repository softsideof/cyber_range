# ==============================================================================
# CyberRange Simulation Environment - Configuration Template
# Copy this file to .env and provide keys for LLM reasoning or HuggingFace sync
# ==============================================================================

# Core Reasoning LLM Configuration (OpenAI, HuggingFace, or custom OpenAI-compatible endpoint)
MODEL_NAME=gpt-4o-mini
API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your_openai_api_key_here

# HuggingFace Spaces Hub Token (Optional, for deploy_to_hf.py)
HF_TOKEN=your_huggingface_write_token_here

# OpenEnv Environment Server Port
ENVIRONMENT_PORT=8000
ENVIRONMENT_HOST=0.0.0.0

# Episode Execution Parameters
MAX_EPISODE_STEPS=25
EVAL_SEED=42
LOG_LEVEL=INFO
